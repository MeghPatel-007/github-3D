{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__iwsdk-runtime__*",
      "mcp__iwsdk-reference__*",
      "mcp__metavr__*",
      "Skill(iwsdk-build-model)",
      "Skill(iwsdk-compose-scene)",
      "Skill(iwsdk-debug)",
      "Skill(iwsdk-depth-occlusion)",
      "Skill(iwsdk-glasses-test)",
      "Skill(iwsdk-grab)",
      "Skill(iwsdk-hosting)",
      "Skill(iwsdk-native-xr-test)",
      "Skill(iwsdk-physics)",
      "Skill(iwsdk-pwa-packaging)",
      "Skill(iwsdk-dev)",
      "Skill(iwsdk-ray)",
      "Skill(iwsdk-ui)"
    ]
  },
  "enabledMcpjsonServers": [
    "iwsdk-runtime",
    "iwsdk-reference",
    "metavr"
  ],
  "defaultMode": "acceptEdits",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/one-task-guard.js"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/play-sound.js notification"
          }
        ]
      }
    ]
  }
}
