# Runtime mode. Set to production when deployed over HTTPS.
NODE_ENV=development

# Public app origin used for same-origin request checks and secure-cookie setup.
WEB_ORIGIN=https://localhost:8081

# GitHub App OAuth credentials (server-side only; never expose with a VITE_ prefix).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# GitHub App slug used to build the installation URL shown by the app.
GITHUB_APP_SLUG=github-3d

# Must match the callback URL configured for the GitHub App.
GITHUB_APP_CALLBACK_URL=https://localhost:8081/auth/github/callback

# Optional: session cookie name. The server defaults to gh3d_session if omitted or invalid.
SESSION_COOKIE_NAME=gh3d_session
